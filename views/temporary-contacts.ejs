<%- include('partials-nav', { activeTab }) %>

<div class="row g-3">
  <div class="col-12 col-lg-4">
    <div class="card">
      <div class="card-header"><h3 class="card-title">New Temporary Contact</h3></div>
      <div class="card-body">
        <form method="post" action="/temporary-contacts" class="d-grid gap-2">
          <label class="form-label">Card Name</label>
          <input class="form-control" name="name" placeholder="Family Silva / Visitor João" required />
          <label class="form-label">Names</label>
          <textarea class="form-control" name="names" rows="2" placeholder="João, Maria, Ana..."></textarea>
          <label class="form-label">Address</label>
          <input class="form-control" name="address" />
          <label class="form-label">Phone</label>
          <input class="form-control" name="phone" />
          <label class="form-label">Notes</label>
          <textarea class="form-control" name="notes" rows="2"></textarea>
          <button class="btn btn-primary" type="submit">Create Temporary Card</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-8">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Temporary Contacts</h3>
      </div>
      <div class="card-body border-bottom">
        <form method="get" action="/temporary-contacts" class="row g-2">
          <div class="col-12 col-md-7">
            <label class="form-label">Search</label>
            <input class="form-control" name="q" value="<%= q || '' %>" placeholder="Name, names, address, notes" />
          </div>
          <div class="col-12 col-md-3">
            <label class="form-label">Status</label>
            <select class="form-select" name="status">
              <option value="open" <%= status === 'open' ? 'selected' : '' %>>Open</option>
              <option value="converted" <%= status === 'converted' ? 'selected' : '' %>>Converted</option>
              <option value="closed" <%= status === 'closed' ? 'selected' : '' %>>Closed</option>
            </select>
          </div>
          <div class="col-12 col-md-2 d-flex align-items-end">
            <button class="btn btn-outline-primary w-100" type="submit">Apply</button>
          </div>
        </form>
      </div>
      <div class="card-body d-grid gap-3">
        <% if (!items.length) { %>
          <div class="text-secondary">No temporary contacts for this filter.</div>
        <% } %>
        <% items.forEach((item) => { %>
          <div class="border rounded p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div class="fw-semibold"><%= item.name %></div>
                <div class="text-secondary small"><%= item.address || 'No address' %></div>
              </div>
              <div class="d-flex gap-2">
                <span class="badge <%= item.status === 'open' ? 'bg-azure-lt' : item.status === 'converted' ? 'bg-green-lt' : 'bg-secondary-lt' %>"><%= item.status %></span>
                <% if (item.openFollowUps) { %><span class="badge bg-orange-lt"><%= item.openFollowUps %> open follow-ups</span><% } %>
              </div>
            </div>
            <div class="small mb-2"><strong>Names:</strong> <%= item.names || '-' %></div>
            <div class="small mb-2"><strong>Phone:</strong> <%= item.phone || '-' %></div>
            <div class="small mb-3"><strong>Notes:</strong> <%= item.notes || '-' %></div>

            <% if (item.status === 'open') { %>
              <form method="post" action="/temporary-contacts/<%= item.id %>/followups" class="row g-2 mb-2">
                <div class="col-12 col-md-4"><input class="form-control" name="title" placeholder="Follow-up task" required /></div>
                <div class="col-12 col-md-3">
                  <select class="form-select" name="contactMethod">
                    <% followUpContactMethods.forEach((method) => { %>
                      <option value="<%= method.value %>"><%= method.label %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-12 col-md-2"><input class="form-control" type="date" name="dueDate" /></div>
                <div class="col-12 col-md-3"><input class="form-control" name="notes" placeholder="Quick note" /></div>
                <div class="col-12 col-md-3">
                  <select class="form-select" name="stage">
                    <% followUpStages.forEach((stageOption) => { %>
                      <option value="<%= stageOption.value %>"><%= stageOption.label %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-12 col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Add Follow-up</button></div>
              </form>

              <div class="d-flex gap-2">
                <form method="post" action="/temporary-contacts/<%= item.id %>/convert">
                  <button class="btn btn-primary btn-sm" type="submit">Convert To Person</button>
                </form>
                <form method="post" action="/temporary-contacts/<%= item.id %>/close">
                  <button class="btn btn-outline-secondary btn-sm" type="submit">Close</button>
                </form>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<%- include('partials-footer') %>

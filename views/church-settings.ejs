<%- include('partials-nav', { activeTab }) %>

<div class="church-settings-shell">
  <div class="card mb-3 church-settings-top-tabs">
    <div class="card-body p-2">
      <div class="nav nav-pills church-settings-tabs">
        <a class="nav-link <%= settingsTab === 'church' ? 'active' : '' %>" href="/settings/church?tab=church"><i class="bi bi-house me-1"></i>Church Settings</a>
        <a class="nav-link <%= settingsTab === 'integrations' ? 'active' : '' %>" href="/settings/church?tab=integrations"><i class="bi bi-puzzle me-1"></i>Add-ons</a>
      </div>
    </div>
  </div>

  <% if (saveStatus === 'saved') { %>
    <div class="alert alert-success" role="alert">Settings saved.</div>
  <% } %>
  <% if (geocodeStatus === 'success') { %>
    <div class="alert alert-info" role="alert">Map coordinates were auto-filled from the church address.</div>
  <% } %>
  <% if (geocodeStatus === 'failed') { %>
    <div class="alert alert-warning" role="alert">Could not auto-detect map coordinates from address right now.</div>
  <% } %>
  <% if (geocodeStatus === 'failed_using_previous') { %>
    <div class="alert alert-warning" role="alert">Could not refresh coordinates now. Keeping previously saved map location.</div>
  <% } %>
  <% if (geocodeStatus === 'missing_address') { %>
    <div class="alert alert-warning" role="alert">Please provide church address details so we can auto-set the map base.</div>
  <% } %>
  <% if (isReadOnly) { %>
    <div class="alert alert-secondary" role="alert">Read-only view. Only admin users can edit settings.</div>
  <% } %>

  <% if (settingsTab === 'church') { %>
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title mb-0">Active Add-ons</h3></div>
      <div class="card-body d-flex flex-wrap gap-2">
        <% if (integrationSettings.calendarEnabled) { %><span class="badge bg-azure-lt">Calendar</span><% } %>
        <% if (integrationSettings.googleCalendarEnabled) { %><span class="badge bg-blue-lt">Google Calendar Sync</span><% } %>
        <% if (integrationSettings.thingsEnabled) { %><span class="badge bg-green-lt">Things</span><% } %>
        <% if (integrationSettings.todoistEnabled) { %><span class="badge bg-orange-lt">Todoist</span><% } %>
      </div>
    </div>

    <form method="post" action="/settings/church" class="d-grid gap-3">
      <input type="hidden" name="settingsTab" value="church" />
      <input type="hidden" name="calendarEnabled" value="<%= integrationSettings.calendarEnabled ? 'on' : '' %>" />
      <input type="hidden" name="googleCalendarEnabled" value="<%= integrationSettings.googleCalendarEnabled ? 'on' : '' %>" />
      <input type="hidden" name="googleCalendarClientId" value="<%= integrationSettings.googleCalendarClientId || '' %>" />
      <input type="hidden" name="googleCalendarClientSecret" value="<%= integrationSettings.googleCalendarClientSecret || '' %>" />
      <input type="hidden" name="googleCalendarRedirectUri" value="<%= integrationSettings.googleCalendarRedirectUri || '' %>" />
      <input type="hidden" name="googleCalendarCalendarId" value="<%= integrationSettings.googleCalendarCalendarId || 'primary' %>" />
      <input type="hidden" name="googleCalendarAccessToken" value="<%= integrationSettings.googleCalendarAccessToken || '' %>" />
      <input type="hidden" name="googleCalendarRefreshToken" value="<%= integrationSettings.googleCalendarRefreshToken || '' %>" />
      <input type="hidden" name="googleCalendarTokenExpiry" value="<%= integrationSettings.googleCalendarTokenExpiry || '' %>" />
      <input type="hidden" name="googleCalendarConnectedAt" value="<%= integrationSettings.googleCalendarConnectedAt || '' %>" />
      <input type="hidden" name="googleCalendarEventMap" value="<%= JSON.stringify(integrationSettings.googleCalendarEventMap || {}) %>" />
      <input type="hidden" name="thingsEnabled" value="<%= integrationSettings.thingsEnabled ? 'on' : '' %>" />
      <input type="hidden" name="thingsEmail" value="<%= integrationSettings.thingsEmail || '' %>" />
      <input type="hidden" name="todoistEnabled" value="<%= integrationSettings.todoistEnabled ? 'on' : '' %>" />
      <input type="hidden" name="todoistApiToken" value="<%= integrationSettings.todoistApiToken || '' %>" />
      <input type="hidden" name="todoistProjectId" value="<%= integrationSettings.todoistProjectId || '' %>" />
      <fieldset <%= isReadOnly ? 'disabled' : '' %>>
      <div class="card church-settings-panel" id="church-details">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h3 class="card-title mb-0">Church Details</h3>
        </div>
        <div class="card-body row g-2">
          <div class="col-12 col-md-7">
            <label class="form-label">Church Name</label>
            <input class="form-control" name="name" value="<%= churchSettings.name || '' %>" placeholder="Igreja batista biblica do vale" />
          </div>
          <div class="col-12 col-md-5">
            <label class="form-label">Email</label>
            <input class="form-control" type="email" name="email" value="<%= churchSettings.email || '' %>" placeholder="church@example.com" />
          </div>
        </div>
      </div>

      <div class="card church-settings-panel" id="contact-details">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h3 class="card-title mb-0">Contact Details</h3>
        </div>
        <div class="card-body row g-2">
          <div class="col-12 col-md-4">
            <label class="form-label">Phone</label>
            <input class="form-control" name="phone" value="<%= churchSettings.phone || '' %>" placeholder="+55 69 99999-9999" />
          </div>
          <div class="col-12 col-md-8">
            <label class="form-label">Address</label>
            <input class="form-control" name="address" value="<%= churchSettings.address || '' %>" placeholder="Street and number" />
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label">City</label>
            <input class="form-control" name="city" value="<%= churchSettings.city || '' %>" placeholder="Porto Velho" />
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label">State</label>
            <input class="form-control" name="state" value="<%= churchSettings.state || '' %>" placeholder="Rondonia" />
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label">ZIP Code</label>
            <input class="form-control" name="zipCode" value="<%= churchSettings.zipCode || '' %>" placeholder="76800-000" />
          </div>
        </div>
      </div>
      </fieldset>

      <div class="d-flex">
        <% if (isReadOnly) { %>
          <button class="btn btn-secondary" type="button" disabled>Admin Required To Save</button>
        <% } else { %>
          <button class="btn btn-primary" type="submit">Save Church Settings</button>
        <% } %>
      </div>
    </form>
  <% } %>

  <% if (settingsTab === 'integrations') { %>
    <form method="post" action="/settings/church">
      <input type="hidden" name="settingsTab" value="integrations" />
      <input type="hidden" name="name" value="<%= churchSettings.name || '' %>" />
      <input type="hidden" name="email" value="<%= churchSettings.email || '' %>" />
      <input type="hidden" name="phone" value="<%= churchSettings.phone || '' %>" />
      <input type="hidden" name="address" value="<%= churchSettings.address || '' %>" />
      <input type="hidden" name="city" value="<%= churchSettings.city || '' %>" />
      <input type="hidden" name="state" value="<%= churchSettings.state || '' %>" />
      <input type="hidden" name="zipCode" value="<%= churchSettings.zipCode || '' %>" />
      <fieldset <%= isReadOnly ? 'disabled' : '' %>>
      <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-4">
          <div class="card">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <strong>Calendar</strong>
                <label class="form-check form-switch m-0">
                  <input class="form-check-input" type="checkbox" name="calendarEnabled" <%= integrationSettings.calendarEnabled ? 'checked' : '' %> />
                </label>
              </div>
              <div class="text-secondary small mb-2">Show Google Calendar action in follow-ups.</div>
              <hr class="my-2" />
              <div class="d-flex justify-content-between align-items-start mb-2">
                <strong>Google Calendar Sync</strong>
                <label class="form-check form-switch m-0">
                  <input class="form-check-input" type="checkbox" name="googleCalendarEnabled" <%= integrationSettings.googleCalendarEnabled ? 'checked' : '' %> />
                </label>
              </div>
              <div class="text-secondary small mb-2">One-way sync from CRM calendar to Google Calendar.</div>
              <label class="form-label small">Client ID</label>
              <input class="form-control form-control-sm mb-2" name="googleCalendarClientId" value="<%= integrationSettings.googleCalendarClientId || '' %>" placeholder="Google OAuth Client ID" />
              <label class="form-label small">Client Secret</label>
              <input class="form-control form-control-sm mb-2" name="googleCalendarClientSecret" value="<%= integrationSettings.googleCalendarClientSecret || '' %>" placeholder="Google OAuth Client Secret" />
              <label class="form-label small">Redirect URI (optional)</label>
              <input class="form-control form-control-sm mb-2" name="googleCalendarRedirectUri" value="<%= integrationSettings.googleCalendarRedirectUri || '' %>" placeholder="https://crm.yourdomain.com/auth/google-calendar/callback" />
              <label class="form-label small">Calendar ID</label>
              <input class="form-control form-control-sm mb-2" name="googleCalendarCalendarId" value="<%= integrationSettings.googleCalendarCalendarId || 'primary' %>" placeholder="primary" />
              <input type="hidden" name="googleCalendarAccessToken" value="<%= integrationSettings.googleCalendarAccessToken || '' %>" />
              <input type="hidden" name="googleCalendarRefreshToken" value="<%= integrationSettings.googleCalendarRefreshToken || '' %>" />
              <input type="hidden" name="googleCalendarTokenExpiry" value="<%= integrationSettings.googleCalendarTokenExpiry || '' %>" />
              <input type="hidden" name="googleCalendarConnectedAt" value="<%= integrationSettings.googleCalendarConnectedAt || '' %>" />
              <input type="hidden" name="googleCalendarEventMap" value="<%= JSON.stringify(integrationSettings.googleCalendarEventMap || {}) %>" />
              <div class="small mb-2 <%= googleCalendarConnected ? 'text-success' : 'text-secondary' %>">
                <%= googleCalendarConnected ? 'Connected to Google Calendar.' : 'Not connected yet.' %>
              </div>
              <% if (!isReadOnly) { %>
                <a class="btn btn-outline-primary btn-sm w-100" href="/auth/google-calendar/connect">Connect Google Calendar</a>
              <% } %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
          <div class="card">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <strong>Things</strong>
                <label class="form-check form-switch m-0">
                  <input class="form-check-input" type="checkbox" name="thingsEnabled" <%= integrationSettings.thingsEnabled ? 'checked' : '' %> />
                </label>
              </div>
              <div class="text-secondary small mb-2">Enable Mail to Things action.</div>
              <label class="form-label small">Things Email</label>
              <input class="form-control form-control-sm" name="thingsEmail" value="<%= integrationSettings.thingsEmail || '' %>" placeholder="add-to-things-xxxx@things.email" />
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6 col-xl-4">
          <div class="card">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <strong>Todoist</strong>
                <label class="form-check form-switch m-0">
                  <input class="form-check-input" type="checkbox" name="todoistEnabled" <%= integrationSettings.todoistEnabled ? 'checked' : '' %> />
                </label>
              </div>
              <div class="text-secondary small mb-2">Enable Todoist task actions.</div>
              <label class="form-label small">API Token</label>
              <input class="form-control form-control-sm mb-2" name="todoistApiToken" value="<%= integrationSettings.todoistApiToken || '' %>" placeholder="Paste token" />
              <label class="form-label small">Project ID (optional)</label>
              <input class="form-control form-control-sm" name="todoistProjectId" value="<%= integrationSettings.todoistProjectId || '' %>" placeholder="e.g. 2312345678" />
            </div>
          </div>
        </div>
      </div>
      </fieldset>

      <div class="d-flex mt-3">
        <% if (isReadOnly) { %>
          <button class="btn btn-secondary" type="button" disabled>Admin Required To Save</button>
        <% } else { %>
          <button class="btn btn-primary" type="submit">Save Add-ons</button>
        <% } %>
      </div>
    </form>
  <% } %>
</div>

<%- include('partials-footer') %>

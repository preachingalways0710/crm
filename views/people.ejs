<%- include('partials-nav', { activeTab }) %>

<div class="row g-3">
  <div class="col-12 col-lg-9">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">People Directory</h3>
        <div class="card-actions d-flex gap-2">
          <span class="badge bg-secondary-lt">
            <%= totalFilteredPeople ? `Showing ${pageRangeStart}-${pageRangeEnd} of ${totalFilteredPeople} people` : '0 people' %>
          </span>
          <span class="badge bg-azure-lt" id="selectedPeopleCountBadge">Selected: 0</span>
          <button class="btn btn-outline-secondary btn-sm" type="button" id="clubKidsImportBtn">Import/Refresh ClubKids Contacts</button>
          <a class="btn btn-primary btn-sm" href="/people/new">+ Person</a>
        </div>
      </div>
      <div class="card-body border-bottom">
        <form method="get" action="/people" class="row g-2" id="peopleFiltersForm">
          <div class="col-12 col-md-3">
            <label class="form-label">Search</label>
            <input class="form-control" name="q" value="<%= q || '' %>" placeholder="Name, phone, email, section, notes" />
          </div>
          <div class="col-12 col-md-2">
            <label class="form-label">Follow-up Filter</label>
            <select class="form-select" name="followups" onchange="this.form.submit()">
              <option value="all" <%= followups === 'all' ? 'selected' : '' %>>All people</option>
              <option value="open" <%= followups === 'open' ? 'selected' : '' %>>Only with open follow-ups</option>
            </select>
          </div>
          <div class="col-12 col-md-2">
            <label class="form-label">Membership</label>
            <select class="form-select" name="membershipType" onchange="this.form.submit()">
              <option value="">Any</option>
              <% membershipTypes.forEach((type) => { %>
                <option value="<%= type %>" <%= membershipTypeFilter === type ? 'selected' : '' %>><%= type %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-md-2">
            <label class="form-label">Tag</label>
            <input class="form-control" name="tag" value="<%= tagFilter || '' %>" list="peopleTagsList" placeholder="Any tag" />
            <datalist id="peopleTagsList">
              <% availableTags.forEach((tag) => { %>
                <option value="<%= tag %>"></option>
              <% }) %>
            </datalist>
          </div>
          <div class="col-12 col-md-1">
            <label class="form-label">Status</label>
            <select class="form-select" name="peopleStatus" onchange="this.form.submit()">
              <option value="active" <%= peopleStatusFilter === 'active' ? 'selected' : '' %>>Active</option>
              <option value="archived" <%= peopleStatusFilter === 'archived' ? 'selected' : '' %>>Archived</option>
              <option value="all" <%= peopleStatusFilter === 'all' ? 'selected' : '' %>>All</option>
            </select>
          </div>
          <div class="col-12 col-md-1">
            <label class="form-label">Per Page</label>
            <select class="form-select" name="perPage" onchange="this.form.submit()">
              <% pageSizeOptions.forEach((size) => { %>
                <option value="<%= size %>" <%= pageSize === size ? 'selected' : '' %>><%= size %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-md-1 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-outline-primary w-100">Search</button>
            <a class="btn btn-outline-secondary" href="/people">Clear</a>
          </div>
        </form>
        <form method="post" action="/people/filters" class="row g-2 mt-1">
          <input type="hidden" name="q" value="<%= q || '' %>" />
          <input type="hidden" name="followups" value="<%= followups || 'all' %>" />
          <input type="hidden" name="membershipType" value="<%= membershipTypeFilter || '' %>" />
          <input type="hidden" name="tag" value="<%= tagFilter || '' %>" />
          <div class="col-12 col-md-4">
            <label class="form-label">Save This Smart Filter</label>
            <input class="form-control" name="name" placeholder="Ex: Follow-ups Convidados Abertos" required />
          </div>
          <div class="col-12 col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-primary w-100">Save Filter</button>
          </div>
          <% if (selectedSmartFilterName) { %>
            <div class="col-12 col-md-6 d-flex align-items-end">
              <span class="badge bg-azure-lt">Active Smart Filter: <%= selectedSmartFilterName %></span>
            </div>
          <% } %>
        </form>
        <div class="mt-3 border-top pt-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong>Selected For Bulk Update</strong>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="bulkClearSelectedBtn">Clear Selected</button>
          </div>
          <div id="bulkPeopleSelectedInline" class="d-flex flex-wrap gap-2"></div>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-vcenter">
          <thead>
            <tr>
              <th class="w-1">
                <label class="form-check m-0">
                  <input class="form-check-input" type="checkbox" id="peopleSelectAll" />
                </label>
              </th>
              <th>Name</th>
              <th>Contact</th>
              <th>Birthday</th>
              <th>Type</th>
              <th>Tags</th>
              <th>Open Follow-ups</th>
              <th class="w-1"></th>
            </tr>
          </thead>
          <tbody>
            <% if (!people.length) { %>
              <tr><td colspan="8" class="text-secondary">No people added yet.</td></tr>
            <% } %>

            <% people.forEach((person) => { %>
              <tr>
                <td>
                  <label class="form-check m-0">
                    <input
                      class="form-check-input people-row-select"
                      type="checkbox"
                      value="<%= person.id %>"
                      data-person-name="<%= person.name %>"
                      data-person-membership="<%= person.membershipType || '' %>"
                      data-person-photo-url="<%= person.photoUrl || '' %>"
                    />
                  </label>
                </td>
                <td>
                  <% if (person.photoUrl) { %>
                    <div class="mb-1"><span class="avatar avatar-md" style="background-image: url('<%= person.photoUrl %>'); background-size: cover; background-position: center;"></span></div>
                  <% } else { %>
                    <div class="mb-1"><span class="avatar avatar-md"><%= person.name?.charAt(0)?.toUpperCase() || '?' %></span></div>
                  <% } %>
                  <div class="fw-semibold"><%= person.name %></div>
                  <div class="text-secondary">Profile <%= person.profilePercent %>% complete</div>
                  <% if (person.archivedAt) { %>
                    <span class="badge bg-yellow-lt mt-1">Archived</span>
                  <% } %>
                </td>
                <td>
                  <div><%= person.phone || '-' %></div>
                  <div class="text-secondary"><%= person.email || '-' %></div>
                </td>
                <td><%= person.birthday ? formatDateDMY(person.birthday) : '-' %></td>
                <td>
                  <span class="badge bg-azure-lt"><%= person.membershipType || 'Convidado' %></span>
                </td>
                <td>
                  <% if ((person.tags || []).length) { %>
                    <div class="d-flex flex-wrap gap-1">
                      <% person.tags.forEach((tag) => { %>
                        <span class="badge bg-secondary-lt"><%= tag %></span>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <span class="text-secondary">-</span>
                  <% } %>
                </td>
                <td><span class="badge <%= person.openFollowUps ? 'bg-red-lt' : 'bg-green-lt' %>"><%= person.openFollowUps %></span></td>
                <td>
                  <a class="btn btn-primary btn-sm" href="/people/<%= person.id %>">Open</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-footer d-flex align-items-center">
        <p class="m-0 text-secondary">Page <%= currentPage %> of <%= totalPages %> · <%= pageSize %> per page</p>
        <ul class="pagination m-0 ms-auto">
          <li class="page-item <%= previousPageUrl ? '' : 'disabled' %>">
            <a class="page-link" href="<%= previousPageUrl || '#' %>" aria-disabled="<%= previousPageUrl ? 'false' : 'true' %>">Previous</a>
          </li>
          <% paginationLinks.forEach((pageLink) => { %>
            <li class="page-item <%= pageLink.isCurrent ? 'active' : '' %>">
              <a class="page-link" href="<%= pageLink.url %>"><%= pageLink.number %></a>
            </li>
          <% }) %>
          <li class="page-item <%= nextPageUrl ? '' : 'disabled' %>">
            <a class="page-link" href="<%= nextPageUrl || '#' %>" aria-disabled="<%= nextPageUrl ? 'false' : 'true' %>">Next</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-3">
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title">Upcoming Birthdays</h3></div>
      <div class="list-group list-group-flush">
        <% if (!upcomingBirthdays.length) { %>
          <div class="list-group-item text-secondary">No birthdays found.</div>
        <% } %>
        <% upcomingBirthdays.forEach((item) => { %>
          <a class="list-group-item list-group-item-action" href="/people/<%= item.id %>">
            <div class="d-flex justify-content-between">
              <strong><%= item.name %></strong>
              <span class="text-secondary"><%= item.daysUntil === 0 ? 'Today' : item.daysUntil + 'd' %></span>
            </div>
            <div class="text-secondary"><%= formatDateDMY(item.nextBirthdayIso) %></div>
          </a>
        <% }) %>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title">Smart Filters</h3></div>
      <div class="list-group list-group-flush">
        <% if (!savedPeopleFilters.length) { %>
          <div class="list-group-item text-secondary">No saved filters yet.</div>
        <% } %>
        <% savedPeopleFilters.forEach((filter) => { %>
          <div class="list-group-item">
            <div class="d-flex justify-content-between align-items-center gap-2">
              <a href="/people?smartFilter=<%= filter.id %>" class="fw-semibold text-decoration-none"><%= filter.name %></a>
              <form method="post" action="/people/filters/<%= filter.id %>/delete" onsubmit="return confirm('Delete this smart filter?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
            <div class="text-secondary small mt-1">
              <% if (filter.q) { %>Search: "<%= filter.q %>" · <% } %>
              <% if (filter.membershipType) { %>Type: <%= filter.membershipType %> · <% } %>
              <% if (filter.tag) { %>Tag: <%= filter.tag %> · <% } %>
              Follow-ups: <%= filter.followups === 'open' ? 'Open only' : 'All' %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title">Bulk Update</h3></div>
      <div class="card-body">
        <form method="post" action="/people/bulk-update" id="bulkPeopleForm" class="d-grid gap-2">
          <input type="hidden" name="returnTo" value="/people?<%= new URLSearchParams({ q: q || '', followups: followups || 'all', membershipType: membershipTypeFilter || '', tag: tagFilter || '', peopleStatus: peopleStatusFilter || 'active', perPage: String(pageSize || 50), ...(selectedSmartFilterId ? { smartFilter: selectedSmartFilterId } : {}) }).toString() %>" />
          <div id="bulkPeopleInputs"></div>
          <label class="form-label">Membership Type</label>
          <select class="form-select" name="bulkMembershipType">
            <option value="">No change</option>
            <% membershipTypes.forEach((type) => { %>
              <option value="<%= type %>"><%= type %></option>
            <% }) %>
          </select>
          <label class="form-label">Follow-up Cadence</label>
          <select class="form-select" name="bulkFollowUpCadenceMonths">
            <option value="">No change</option>
            <option value="0">Disabled</option>
            <option value="1">Every month</option>
            <option value="2">Every 2 months</option>
          </select>
          <label class="form-label">Add Tag</label>
          <input class="form-control" name="bulkAddTag" placeholder="optional" />
          <label class="form-label">Remove Tag</label>
          <input class="form-control" name="bulkRemoveTag" placeholder="optional" />
          <button class="btn btn-primary" type="submit">Run Bulk Update</button>
        </form>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header"><h3 class="card-title">Quick Actions</h3></div>
      <div class="card-body d-grid gap-2">
        <a class="btn btn-outline-primary" href="/people/new">+ Add Person</a>
        <a class="btn btn-outline-secondary" href="/import">Import People</a>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const storageKey = 'crm.bulkSelectedPeople.v1';
    const selectedEl = document.getElementById('bulkPeopleSelectedInline');
    const hiddenInputsEl = document.getElementById('bulkPeopleInputs');
    const clearBtn = document.getElementById('bulkClearSelectedBtn');
    const selectedCountBadge = document.getElementById('selectedPeopleCountBadge');
    const selectAllEl = document.getElementById('peopleSelectAll');
    const rowCheckboxes = Array.from(document.querySelectorAll('.people-row-select'));
    if (!selectedEl || !hiddenInputsEl) return;

    const selected = new Map();

    const loadPersisted = () => {
      try {
        const parsed = JSON.parse(localStorage.getItem(storageKey) || '[]');
        if (!Array.isArray(parsed)) return;
        parsed.forEach((person) => {
          if (!person || !person.id) return;
          selected.set(person.id, {
            id: String(person.id),
            name: String(person.name || 'Unnamed'),
            membershipType: String(person.membershipType || ''),
            photoUrl: String(person.photoUrl || '')
          });
        });
      } catch {
        // Ignore malformed local storage payload.
      }
    };

    const persist = () => {
      const payload = Array.from(selected.values()).map((entry) => ({
        id: entry.id,
        name: entry.name,
        membershipType: entry.membershipType,
        photoUrl: entry.photoUrl
      }));
      localStorage.setItem(storageKey, JSON.stringify(payload));
    };

    const renderSelected = () => {
      selectedEl.innerHTML = '';
      hiddenInputsEl.innerHTML = '';
      rowCheckboxes.forEach((checkbox) => {
        checkbox.checked = selected.has(checkbox.value);
      });
      if (selectAllEl) {
        const total = rowCheckboxes.length;
        const checked = rowCheckboxes.filter((entry) => entry.checked).length;
        selectAllEl.checked = total > 0 && checked === total;
        selectAllEl.indeterminate = checked > 0 && checked < total;
      }
      selected.forEach((person) => {
        const chip = document.createElement('span');
        chip.className = 'badge bg-azure-lt d-inline-flex align-items-center gap-2';
        chip.textContent = person.name;
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'btn btn-sm btn-ghost-secondary p-0 px-1';
        remove.textContent = 'x';
        remove.onclick = () => {
          selected.delete(person.id);
          renderSelected();
        };
        chip.appendChild(remove);
        selectedEl.appendChild(chip);

        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'selectedIds';
        hidden.value = person.id;
        hiddenInputsEl.appendChild(hidden);
      });
      if (!selected.size) {
        const empty = document.createElement('span');
        empty.className = 'text-secondary small';
        empty.textContent = 'No people selected yet.';
        selectedEl.appendChild(empty);
      }
      if (selectedCountBadge) {
        selectedCountBadge.textContent = `Selected: ${selected.size}`;
      }
      persist();
    };

    rowCheckboxes.forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        if (checkbox.checked) {
          selected.set(checkbox.value, {
            id: checkbox.value,
            name: checkbox.dataset.personName || 'Unnamed',
            membershipType: checkbox.dataset.personMembership || '',
            photoUrl: checkbox.dataset.personPhotoUrl || ''
          });
        } else {
          selected.delete(checkbox.value);
        }
        renderSelected();
      });
    });

    if (selectAllEl) {
      selectAllEl.addEventListener('change', () => {
        rowCheckboxes.forEach((checkbox) => {
          checkbox.checked = selectAllEl.checked;
          if (selectAllEl.checked) {
            selected.set(checkbox.value, {
              id: checkbox.value,
              name: checkbox.dataset.personName || 'Unnamed',
              membershipType: checkbox.dataset.personMembership || '',
              photoUrl: checkbox.dataset.personPhotoUrl || ''
            });
          } else {
            selected.delete(checkbox.value);
          }
        });
        renderSelected();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        selected.clear();
        renderSelected();
      });
    }

    loadPersisted();
    renderSelected();
  })();
</script>

<%- include('partials-footer') %>

<script>
  (function () {
    const button = document.getElementById('clubKidsImportBtn');
    if (!button) return;

    const allowedClubKidsOrigin = 'https://clubkids.meuibbv.com';
    const popupUrl = `${allowedClubKidsOrigin}/`;

    async function importKids(kids) {
      const response = await fetch('/api/integrations/clubkids/bulk-sync', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kids })
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(payload?.error || 'Could not import ClubKids contacts.');
      }
      return payload;
    }

    button.addEventListener('click', () => {
      const popup = window.open(popupUrl, 'clubkids-crm-import', 'width=1200,height=850');
      if (!popup) {
        window.alert('Please allow popups for ClubKids import.');
        return;
      }

      const originalLabel = button.textContent;
      button.disabled = true;
      button.textContent = 'Importing...';

      const cleanup = () => {
        button.disabled = false;
        button.textContent = originalLabel;
        window.removeEventListener('message', onMessage);
        clearInterval(pingTimer);
        clearTimeout(timeoutTimer);
      };

      const onMessage = async (event) => {
        if (event.origin !== allowedClubKidsOrigin) return;
        if (event.data?.type !== 'crm-clubkids-export-response') return;

        try {
          const result = await importKids(Array.isArray(event.data.kids) ? event.data.kids : []);
          cleanup();
          try { popup.close(); } catch {}
          window.alert(`ClubKids import complete. Received ${result.received || 0}, created ${result.created || 0}, updated ${result.updated || 0}.`);
          window.location.reload();
        } catch (error) {
          cleanup();
          window.alert(error.message || 'ClubKids import failed.');
        }
      };

      window.addEventListener('message', onMessage);

      const pingTimer = setInterval(() => {
        if (popup.closed) {
          cleanup();
          return;
        }
        popup.postMessage({ type: 'crm-clubkids-export-request' }, allowedClubKidsOrigin);
      }, 700);

      const timeoutTimer = setTimeout(() => {
        cleanup();
        window.alert('ClubKids import timed out. Keep ClubKids open and try again.');
      }, 30000);
    });
  })();
</script>
